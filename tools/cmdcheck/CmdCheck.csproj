<!-- dotnet run -project tools/cmdcheck — self-check for SrsCommandMap (the page → SRS command allow-list).
     Compiles the plugin's Unity-free file directly, so it needs no game install. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\plugin\SrsCommandMap.cs" />
  </ItemGroup>
</Project>
